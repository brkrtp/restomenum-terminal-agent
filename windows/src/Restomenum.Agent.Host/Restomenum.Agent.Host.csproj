<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <!-- net8.0 (net8.0-windows DEĞİL): çekirdek ve host çapraz platform derlenebilsin ki
         protokol ve yaşam döngüsü Windows makinesi olmadan da test edilebilsin. Windows'a
         özgü olan tek şey cihaz anahtarı ve GMP sarmalayıcısıdır; ikisi de AYRI projede. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>restomenum-agent-host</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!-- ValidateDataAnnotations: eksik yapilandirmayla ACILISTA durmak icin. -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="8.0.0" />
    <!-- Windows servisi olarak çalışmayı sağlar. Windows dışında `UseWindowsService()`
         sessizce hiçbir şey yapmaz, bu yüzden koşullu referans gerekmez. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Restomenum.Agent.Core/Restomenum.Agent.Core.csproj" />
  </ItemGroup>
</Project>
